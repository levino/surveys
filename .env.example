# Copy to .env and fill in. See README.md for details.

PORT=8080
DATABASE_PATH=./data/app.db
PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_APP_NAME=Surveys
PUBLIC_THEME=surveys

# Upstream OIDC identity provider (Zitadel, Keycloak, dex, …).
# Teams come from the user's own tokens: the `groups` claim, or with
# ZITADEL_TEAM_PROJECTS the ZITADEL project role claims.
# Register redirect URI <base>/login/callback and back-channel logout URI
# <base>/login/backchannel-logout; the client needs refresh tokens.
OIDC_ISSUER=
OIDC_CLIENT_ID=surveys
OIDC_CLIENT_SECRET=
# Optional: strip a namespace prefix from group strings (e.g. "myorg:").
OIDC_GROUP_PREFIX=
# Provider tokens older than this are refreshed (teams re-derived) on next use.
OIDC_REFRESH_INTERVAL=10m
# ZITADEL: one team per project, "<projectId>=<slug>,…"; role making maintainers.
ZITADEL_TEAM_PROJECTS=
ZITADEL_MAINTAINER_ROLE=admin

# Random secret used to salt IP hashes (set to a long random string).
SESSION_SECRET=
